{
  "name": "@vivasvana/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "reset": "prisma migrate reset --force && pnpm seed",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "format": "prisma format",
    "lint": "echo 'no-op'",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no-op'",
    "clean": "rm -rf node_modules .turbo"
  },
  "dependencies": {
    "@prisma/client": "5.20.0"
  },
  "devDependencies": {
    "@vivasvana/config": "workspace:*",
    "prisma": "5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "@types/node": "^20.14.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
