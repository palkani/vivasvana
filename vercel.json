{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @vivasvana/db generate && pnpm --filter @vivasvana/web build",
  "devCommand": "pnpm --filter @vivasvana/web dev",
