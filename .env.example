# =============================================================================
# Vivasvana — Environment variables (example)
# Copy to .env at repo root for local dev. Never commit real values.
# =============================================================================

# ---- Node / runtime ----
NODE_ENV=development

# ---- Database (Postgres via Supabase local stack) ----
# DATABASE_URL goes through pgbouncer for app queries (port 54322 locally)
# DIRECT_URL bypasses pooler for Prisma migrations
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ---- Supabase (auth + storage) ----
# `supabase start` prints these locally. For prod, get from Supabase dashboard.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="eyJhbGciOiJI..."           # public, safe in browser
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJI..."   # SERVER ONLY — bypasses RLS
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"

# ---- Redis (Upstash in prod; local docker for dev) ----
REDIS_URL="redis://127.0.0.1:6379"

# ---- Fastify API ----
API_PORT=4000
API_HOST="0.0.0.0"
API_URL="http://localhost:4000"
API_CORS_ORIGINS="http://localhost:3000"
JWT_SECRET="change-me-locally-but-actually-use-supabase-jwt-secret-above"

# ---- Next.js web ----
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJI..."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Payments: Razorpay (test mode keys for dev) ----
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="webhook-secret-set-in-razorpay-dashboard"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ---- Shipping: Shiprocket ----
SHIPROCKET_EMAIL="ops@vivasvana.com"
SHIPROCKET_PASSWORD="xxxxxxxxxxxx"
SHIPROCKET_PICKUP_LOCATION="Primary"

# ---- Transactional email: Resend ----
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="orders@vivasvana.com"
RESEND_FROM_NAME="Vivasvana"

# ---- India Post PIN lookup (free, no key needed) ----
# https://api.postalpincode.in/pincode/{pincode}

# ---- Analytics ----
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="vivasvana.com"
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""

# ---- Error tracking (Sentry) ----
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ---- Storage (Supabase Storage bucket name) ----
SUPABASE_PRODUCT_IMAGES_BUCKET="product-images"
SUPABASE_BLOG_IMAGES_BUCKET="blog-images"
