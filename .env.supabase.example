# Template for scripts/deploy-supabase.sh
# Copy to `.env.supabase` and fill from Supabase dashboard.
# DO NOT commit `.env.supabase` — only this `.example` file.

# Supabase Dashboard → Settings → Database → Connection string → URI
# Direct connection (port 5432) — required for Prisma migrate
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres"

# Pooler (port 6543, transaction mode) — used at app runtime, recommended for
# serverless/Vercel. The `?pgbouncer=true&connection_limit=1` suffix is
# REQUIRED: without pgbouncer=true, Prisma uses prepared statements that
# collide across pooled connections and every other query fails with
# `prepared statement "sN" already exists` (Postgres 42P05). connection_limit=1
# keeps each serverless instance from exhausting the pool.
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Dashboard → Settings → API
SUPABASE_URL="https://YOUR_REF.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET="..."

# Storage bucket names — defaults match the app
SUPABASE_PRODUCT_IMAGES_BUCKET="product-images"
SUPABASE_BLOG_IMAGES_BUCKET="blog-images"
